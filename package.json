{
  "name": "bocchy",
  "productName": "Bocchy",
  "version": "1.3.1",
  "description": "Bocchy Browser - Fast, Private, Media-Sniffing Custom Web Browser",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build.mjs",
    "start": "electron dist-electron/main.js",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.4.30",
    "cross-fetch": "^4.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.bocchy.browser",
    "productName": "Bocchy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "bocchy.ico",
      "bocchy.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "bocchy.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "bocchy.ico",
      "uninstallerIcon": "bocchy.ico",
      "uninstallDisplayName": "Bocchy Browser",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bocchy"
    },
    "portable": {
      "artifactName": "Bocchy-Portable-${version}.${ext}"
    }
  }
}
